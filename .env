# ===========================================
# Whisper-Input-Next 环境变量配置
# 本配置仅使用 WeNet 本地离线 ASR，无需网络连接
# ===========================================

# ===== 服务平台配置 =====
# 使用本地模式（不需要 OpenAI 或其他云服务）
SERVICE_PLATFORM=local

# ===== WeNet 本地 ASR 配置（唯一使用的转录服务） =====
# 启用 WeNet 本地离线识别
WENET_ENABLED=true
# WeNet WebSocket 服务地址（本地部署）
WENET_WS_URL=ws://localhost:10086

# 转录服务选择：wenet（本地离线）
TRANSCRIPTION_SERVICE=wenet

# ===== 键盘快捷键配置 =====
# 使用右 Command 键作为按住录音快捷键（Linux 系统）
# 按住 cmd_r 开始录音，松开停止录音并转录
HOLD_BUTTON=cmd_r

# 系统平台：linux
SYSTEM_PLATFORM=linux

# ===== 功能开关 =====
# 是否转换为简体中文
CONVERT_TO_SIMPLIFIED=false
# 是否自动添加标点符号
ADD_SYMBOL=false
# 是否优化结果
OPTIMIZE_RESULT=false
# 自动重试次数
AUTO_RETRY_LIMIT=3

# ===========================================
# 使用说明：
# 1. 确保 WeNet Docker 服务已启动：
#    ./scripts/wenet_service.sh start
# 
# 2. 启动应用：
#    ./start.sh
#
# 3. 按住右 Command 键（cmd_r）开始录音
#    松开按键自动进行语音识别并输入文字
#
# 注意：本配置完全离线，无需任何网络连接和 API 密钥
# ===========================================

# 转录按钮（即使使用 HOLD_BUTTON 也需要设置）
TRANSCRIPTIONS_BUTTON=f
# 翻译按钮
TRANSLATIONS_BUTTON=ctrl
