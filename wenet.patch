@@ -0,0 +1,109 @@
+import asyncio
+import websockets
+import json
+import base64
+
+
+class WeNetProvider:
+    def __init__(self, url="ws://127.0.0.1:10086"):
+        self.url = url
+        self.ws = None
+        self.running = False
+        self.recv_task = None
+        self.on_result_callback = None
+
+    async def connect(self):
+        self.ws = await websockets.connect(self.url)
+
+    async def start(self, on_result=None):
+        await self.connect()
+        self.running = True
+        self.on_result_callback = on_result
+        self.recv_task = asyncio.create_task(self._recv_loop())
+
+    async def _recv_loop(self):
+        try:
+            async for message in self.ws:
+                data = json.loads(message)
+
+                result = {
+                    "text": data.get("result", ""),
+                    "final": data.get("is_final", False),
+                }
+
+                if self.on_result_callback:
+                    self.on_result_callback(result)
+
+        except Exception as e:
+            print("WeNet recv error:", e)
+
+    async def send_audio(self, pcm_bytes):
+        if not self.ws or not self.running:
+            return
+
+        payload = {
+            "audio": base64.b64encode(pcm_bytes).decode()
+        }
+
+        try:
+            await self.ws.send(json.dumps(payload))
+        except Exception as e:
+            print("WeNet send error:", e)
+
+    async def stop(self):
+        self.running = False
+
+        if self.recv_task:
+            self.recv_task.cancel()
+
+        if self.ws:
+            try:
+                await self.ws.close()
+            except:
+                pass
+
+        self.ws = None
+
